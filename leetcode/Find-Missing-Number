class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        int n = nums.size();
        int minimum = nums[0];
        int maximum = nums[n-1];

        vector<int>temp(maximum+1,0);

        for(int i =0;i<n;i++){
            temp[nums[i]]++;
        }

        vector<int> result;
        for(int i =minimum;i<maximum;i++){
            if(temp[i]==0){
                result.push_back(i);
            }

        }

        return result;
    }
};


class Solution {
public:
    int smallestNumber(int n, int t) {
        while (true) {
            int x = n;
            int product = 1;

            while (x > 0) {
                product *= (x % 10);
                x /= 10;
            }

            if (product % t == 0)
                return n;

            n++;
        }
    }
};
